+import path from "node:path";
+import { expectDefined } from "@openclaw/normalization-core";
+import { beforeEach, describe, expect, it } from "vitest";
+import { resolveStateDir } from "../config/paths.js";
+import {
+  configWriteMock,
+  installPluginFromNpmSpecMock,
+  readConfigFileSnapshotForWriteMock,
+  resetPluginsCliTestState,
+  restorePersistedInstalledPluginIndexIfCurrentMock,
+  runPluginsCommand,
+  writePersistedInstalledPluginIndexInstallRecordsWithLeaseMock,
+} from "./plugins-cli-test-helpers.js";
+
+function npmSpec(request: unknown): string {
+  if (
+    !request ||
+    typeof request !== "object" ||
+    !("spec" in request) ||
+    typeof request.spec !== "string"
+  ) {
+    throw new Error("Expected an npm installation request");
+  }
+  return request.spec;
+}
+
+describe("plugins install multiple sources", () => {
+  beforeEach(() => {
+    resetPluginsCliTestState();
+    installPluginFromNpmSpecMock.mockImplementation(async (request: unknown) => {
+      const pluginId = npmSpec(request).replace(/^npm:/, "");
+      return {
+        ok: true,
+        pluginId,
+        targetDir: path.join(resolveStateDir(), "extensions", pluginId),
+        version: "1.2.3",
+        npmResolution: { packageName: pluginId, resolvedVersion: "1.2.3" },
+      };
+    });
+  });
+
+  const install = (...sources: string[]) =>
+    runPluginsCommand([
+      "plugins",
+      "install",
+      ...sources,
+      "--force",
+      "--accept-capabilities",
+      "--no-enable",
+    ]);
+
+  it("commits sources in order with fresh configuration and install records", async () => {
+    await install("npm:alpha", "npm:beta");
+
+    expect(installPluginFromNpmSpecMock.mock.calls.map(([request]) => npmSpec(request))).toEqual([
+      "alpha",
+      "beta",
+    ]);
+    // Each source reads once before its lease and again for the persistent apply.
+    expect(readConfigFileSnapshotForWriteMock).toHaveBeenCalledTimes(4);
+    expect(configWriteMock).toHaveBeenCalledTimes(2);
+    const commits = writePersistedInstalledPluginIndexInstallRecordsWithLeaseMock.mock.calls;
+    expect(commits).toHaveLength(2);
+    const firstCommit = expectDefined(commits[0], "first installation commit");
+    const secondCommit = expectDefined(commits[1], "second installation commit");
+    expect(Object.keys(firstCommit[0])).toEqual(["alpha"]);
+    expect(Object.keys(secondCommit[0])).toEqual(["alpha", "beta"]);
+    expect(secondCommit[0]).toMatchObject({
+      alpha: { version: "1.2.3" },
+      beta: { version: "1.2.3" },
+    });
+  });
+
+  it("stops at a failure and preserves an earlier successful commit", async () => {
+    installPluginFromNpmSpecMock.mockResolvedValueOnce({
+      ok: true,
+      pluginId: "alpha",
+      targetDir: path.join(resolveStateDir(), "extensions", "alpha"),
+      version: "1.2.3",
+    });
+    installPluginFromNpmSpecMock.mockResolvedValueOnce({
+      ok: false,
+      error: "plugin blocked by security policy",
+      code: "security_scan_blocked",
+    });
+
+    await expect(install("npm:alpha", "npm:beta", "npm:gamma")).rejects.toThrow("__exit__:1");
+
+    expect(installPluginFromNpmSpecMock.mock.calls.map(([request]) => npmSpec(request))).toEqual([
+      "alpha",
+      "beta",
+    ]);
+    expect(configWriteMock).toHaveBeenCalledTimes(1);
+    expect(
+      expectDefined(
+        writePersistedInstalledPluginIndexInstallRecordsWithLeaseMock.mock.calls[0],
+        "successful installation commit",
+      )[0],
+    ).toMatchObject({
+      alpha: { version: "1.2.3" },
+    });
+    expect(writePersistedInstalledPluginIndexInstallRecordsWithLeaseMock).toHaveBeenCalledTimes(1);
+    expect(restorePersistedInstalledPluginIndexIfCurrentMock).not.toHaveBeenCalled();
+  });
+});
