@@ -0,0 +1,130 @@
+import type { BigIntStats, Stats } from "node:fs";
+import path from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+
+const events: string[] = [];
+
+vi.mock("./sqlite-integrity.js", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("./sqlite-integrity.js")>();
+  return {
+    ...actual,
+    assertSqliteIntegrity: vi.fn((database: DatabaseSync, pathname: string) => {
+      events.push(`integrity:${pathname}`);
+      return actual.assertSqliteIntegrity(database, pathname);
+    }),
+  };
+});
+
+vi.mock("./sqlite-snapshot-file.js", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("./sqlite-snapshot-file.js")>();
+  return {
+    ...actual,
+    hashPublishedFileSync: vi.fn((pathname: string, identity: Stats | BigIntStats) => {
+      events.push(`prehash:${pathname}`);
+      return actual.hashPublishedFileSync(pathname, identity);
+    }),
+  };
+});
+
+const { createVerifiedSqliteSnapshot } = await import("./sqlite-snapshot.js");
+
+const directories = useAutoCleanupTempDirTracker(afterEach);
+
+function createFixture() {
+  const root = directories.make("openclaw-snapshot-prefetch-");
+  const sourcePath = path.join(root, "source.sqlite");
+  const targetPath = path.join(root, "target.sqlite");
+  const database = new DatabaseSync(sourcePath);
+  database.exec(
+    "CREATE TABLE records (value TEXT NOT NULL); INSERT INTO records VALUES ('source');",
+  );
+  database.close();
+  return { root, sourcePath, targetPath };
+}
+
+afterEach(() => {
+  events.length = 0;
+});
+
+describe("private snapshot prehash admission", () => {
+  it("hashes the selected private image before its first integrity check", async () => {
+    const fixture = createFixture();
+
+    await createVerifiedSqliteSnapshot({
+      sourcePath: fixture.sourcePath,
+      targetPath: fixture.targetPath,
+      sourceAcquisition: {
+        mode: "isolated-process",
+        stagingRoot: fixture.root,
+        preserveSourceArtifacts: true,
+      },
+    });
+
+    expect(events[0]).toMatch(/^prehash:/u);
+    expect(events[0]).not.toBe(`prehash:${fixture.sourcePath}`);
+    expect(events[1]).toBe(`integrity:${fixture.sourcePath}`);
+  });
+
+  it("does not prehash a live source when no private image is selected", async () => {
+    const fixture = createFixture();
+
+    await createVerifiedSqliteSnapshot(fixture);
+
+    expect(events.filter((event) => event.startsWith("prehash:")).length).toBe(0);
+    expect(events.filter((event) => event.startsWith("integrity:"))).toEqual([
+      `integrity:${fixture.sourcePath}`,
+      `integrity:${fixture.targetPath}`,
+    ]);
+  });
+
+  it("fails before integrity when private-image prehash detects an early mutation", async () => {
+    const fixture = createFixture();
+    const snapshotFile = await import("./sqlite-snapshot-file.js");
+    const prehash = vi.mocked(snapshotFile.hashPublishedFileSync);
+    prehash.mockImplementationOnce((pathname) => {
+      events.push(`prehash:${pathname}`);
+      throw new Error("private image changed while prehashing");
+    });
+
+    await expect(
+      createVerifiedSqliteSnapshot({
+        sourcePath: fixture.sourcePath,
+        targetPath: fixture.targetPath,
+        sourceAcquisition: {
+          mode: "isolated-process",
+          stagingRoot: fixture.root,
+          preserveSourceArtifacts: true,
+        },
+      }),
+    ).rejects.toThrow("private image changed while prehashing");
+    expect(events).toEqual([expect.stringMatching(/^prehash:/u)]);
+  });
+
+  it("retains fresh transform content and both validation boundaries", async () => {
+    const fixture = createFixture();
+    const validation: string[] = [];
+
+    await createVerifiedSqliteSnapshot({
+      sourcePath: fixture.sourcePath,
+      targetPath: fixture.targetPath,
+      sourceAcquisition: {
+        mode: "isolated-process",
+        stagingRoot: fixture.root,
+        preserveSourceArtifacts: true,
+      },
+      transform: (database) => {
+        database.exec("DELETE FROM records; INSERT INTO records VALUES ('transformed');");
+      },
+      validate: (database, label) => {
+        validation.push(`${label}:${database.prepare("SELECT value FROM records").get()?.value}`);
+      },
+    });
+
+    expect(validation).toEqual([
+      `${fixture.sourcePath}:source`,
+      `${fixture.targetPath}:transformed`,
+    ]);
+  });
+});
