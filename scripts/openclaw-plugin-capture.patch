+import type { PluginCandidate } from "./discovery.js";
+import { loadRuntimePluginCandidate } from "./loader-runtime-candidate.js";
+import type { PluginLoadInput } from "./loader-runtime-retention.js";
+import type { PluginManifestRecord } from "./manifest-registry.js";
+import { getPluginCache } from "./plugin-cache.js";
+import { withPluginRegistryPreparationScope } from "./registry-lifecycle.js";
+import type { PluginRecord } from "./registry-types.js";
+
+type CandidateSteps = ReturnType<typeof loadRuntimePluginCandidate>;
+type RunCandidate = <T>(run: () => T) => T;
+export type PendingPluginPreparation = {
+  id: string;
+  steps: CandidateSteps;
+  prepare: () => Promise<void>;
+};
+
+export function* finishPluginCandidate(
+  steps: CandidateSteps,
+  initialStep: IteratorResult<(() => Promise<void>) | undefined, void>,
+  runCandidate: RunCandidate,
+): Generator<(() => Promise<void>) | undefined, void> {
+  let step = initialStep;
+  while (!step.done) {
+    const prepare = step.value;
+    try {
+      yield prepare && (() => runCandidate(prepare));
+      step = runCandidate(() => steps.next());
+    } catch (error) {
+      step = runCandidate(() => steps.throw(error));
+    }
+  }
+}
+export function* finishPluginPreparations(
+  preparing: PendingPluginPreparation[],
+  runCandidate: RunCandidate,
+): Generator<(() => Promise<void>) | undefined, void> {
+  if (!preparing.length) {
+    return;
+  }
+  const batch = preparing.splice(0);
+  let outcomes: PromiseSettledResult<void>[] | undefined;
+  // Only acquisition overlaps. Consume every result through its original candidate
+  // so registration, diagnostics, and rollback retain manifest order.
+  yield async () => {
+    outcomes = await Promise.allSettled(
+      batch.map(({ prepare }) => Promise.resolve().then(() => runCandidate(prepare))),
+    );
+  };
+  let completed = 0;
+  try {
+    if (getPluginCache().retirement) {
+      throw new Error("Plugin inventory has retired; begin a new plugin operation.");
+    }
+    for (const { steps } of batch) {
+      const outcome = outcomes?.[completed];
+      completed++;
+      const step = runCandidate(() =>
+        outcome?.status === "rejected" ? steps.throw(outcome.reason) : steps.next(),
+      );
+      yield* finishPluginCandidate(steps, step, runCandidate);
+      yield;
+      if (getPluginCache().retirement) {
+        throw new Error("Plugin inventory has retired; begin a new plugin operation.");
+      }
+    }
+  } catch (error) {
+    // Prepared instances are not in registry.plugins until their continuation runs.
+    // On an aborted load, let each suspended candidate roll back its own capture.
+    const failures: unknown[] = [error];
+    for (const { steps } of batch.slice(completed)) {
+      try {
+        steps.throw(new Error("Plugin inventory has retired; begin a new plugin operation."));
+      } catch (cleanupError) {
+        failures.push(cleanupError);
+      }
+    }
+    if (failures.length > 1) {
+      throw new AggregateError(failures, "Plugin preparation and rollback failed", {
+        cause: error,
+      });
+    }
+    throw error;
+  }
+}
+
+type CandidateParameters = Parameters<typeof loadRuntimePluginCandidate>[0];
+/** Prepare independent external sources in bounded batches; publish each candidate in manifest order. */
+export function* loadPreparedRuntimePluginCandidates(
+  parameters: Pick<
+    CandidateParameters,
+    | "context"
+    | "options"
+    | "onlyPluginIdSet"
+    | "dreamingSidecar"
+    | "validateOnly"
+    | "registryBuilder"
+    | "loadPluginModule"
+    | "logger"
+    | "state"
+  > & {
+    orderedCandidates: readonly PluginCandidate[];
+    manifestBySource: ReadonlyMap<string, PluginManifestRecord>;
+    retained: ReadonlyMap<string, PluginRecord>;
+    inputs: ReadonlyMap<string, PluginLoadInput>;
+    sourcePreparationConcurrency: number;
+  },
+): Generator<(() => Promise<void>) | undefined, void> {
+  const {
+    context,
+    options,
+    onlyPluginIdSet,
+    dreamingSidecar,
+    validateOnly,
+    registryBuilder: builder,
+    loadPluginModule,
+    logger,
+    state,
+    orderedCandidates,
+    manifestBySource,
+    retained,
+    inputs,
+    sourcePreparationConcurrency,
+  } = parameters;
+  const { registry } = builder;
+  const runCandidate = <T>(run: () => T): T =>
+    options.previousRegistry ? withPluginRegistryPreparationScope(registry, run) : run();
+  const preparing: PendingPluginPreparation[] = [];
+  for (const candidate of orderedCandidates) {
+    const manifestRecord = manifestBySource.get(candidate.source);
+    if (!manifestRecord) {
+      continue;
+    }
+    if (
+      retained.has(manifestRecord.id) ||
+      candidate.origin === "bundled" ||
+      options.moduleRecoveries?.has(manifestRecord.id) ||
+      state.seenIds.has(manifestRecord.id) ||
+      preparing.some(({ id }) => id === manifestRecord.id)
+    ) {
+      yield* finishPluginPreparations(preparing, runCandidate);
+    }
+    const previous = retained.get(manifestRecord.id);
+    if (previous && !state.seenIds.has(manifestRecord.id)) {
+      registry.plugins.push(previous);
+      state.seenIds.set(previous.id, previous.origin);
+      if (previous.memorySlotSelected) {
+        state.selectedMemoryPluginId = previous.id;
+        state.memorySlotMatched = true;
+      }
+      continue;
+    }
+    const input = inputs.get(manifestRecord.id);
+    const candidateSteps = loadRuntimePluginCandidate({
+      candidate,
+      manifestRecord,
+      context,
+      options,
+      onlyPluginIdSet,
+      dreamingSidecar,
+      validateOnly,
+      registryBuilder: builder,
+      loadPluginModule,
+      logger,
+      state,
+      preparedConfig: input?.source === candidate.source ? input.config : { input: undefined },
+    });
+    const candidateStep = runCandidate(() => candidateSteps.next());
+    if (!candidateStep.done && candidateStep.value) {
+      preparing.push({
+        id: manifestRecord.id,
+        steps: candidateSteps,
+        prepare: candidateStep.value,
+      });
+      if (preparing.length === sourcePreparationConcurrency) {
+        yield* finishPluginPreparations(preparing, runCandidate);
+      }
+      continue;
+    }
+    yield* finishPluginPreparations(preparing, runCandidate);
+    yield* finishPluginCandidate(candidateSteps, candidateStep, runCandidate);
+  }
+  yield* finishPluginPreparations(preparing, runCandidate);
+}
