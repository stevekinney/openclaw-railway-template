@@ -0,0 +1,130 @@
+import { randomUUID } from "node:crypto";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { expect, it, vi } from "vitest";
+import { parseUpdateRecoveryBackupManifest } from "../commands/backup-verify-manifest.js";
+import { withOpenClawTestState } from "../test-utils/openclaw-test-state.js";
+import { resolveUpdateCaptureRoot } from "./update-capture-paths.js";
+import { retireStandaloneDoctorCaptures } from "./update-recovery-doctor-retention.js";
+import { getUpdateRunAsync } from "./update-run-reader.js";
+
+it("bounds sealed standalone Doctor captures by count and age while preserving protected copies", async () => {
+  await withOpenClawTestState({ scenario: "minimal" }, async (state) => {
+    const now = Date.parse("2026-09-30T12:00:00.000Z");
+    const day = 24 * 60 * 60_000;
+    const store = resolveUpdateCaptureRoot(state.stateDir);
+    const sealed = async (runId: string, ageDays: number, directory = path.join(store, runId)) => {
+      const manifest = {
+        schemaVersion: 2,
+        kind: "update-recovery",
+        generation: { kind: "baseline" },
+        databases: [],
+        runId,
+        installRoot: state.root,
+        stateDir: state.stateDir,
+        configPath: state.configPath,
+        configPaths: [state.configPath],
+        creator: { host: "fixture", pid: 1, startIdentity: "1" },
+        drivers: [],
+        createdAt: new Date(now - ageDays * day).toISOString(),
+        roots: [state.configPath],
+        excludedRoots: [],
+        protectedPaths: [state.configPath],
+        entries: [
+          { kind: "missing", sourcePath: state.configPath, sqlite: false, directory: false },
+        ],
+      };
+      const raw = JSON.stringify(manifest);
+      parseUpdateRecoveryBackupManifest(raw);
+      await fs.mkdir(directory, { recursive: true });
+      await fs.writeFile(path.join(directory, "manifest.json"), raw);
+      expect(await getUpdateRunAsync(runId)).toBeUndefined();
+      return directory;
+    };
+    const expired = await sealed(`doctor-${randomUUID()}`, 31);
+    const recent = await sealed(`doctor-${randomUUID()}`, 1);
+    const retainedRecent = await Promise.all(
+      [2, 3].map((age) => sealed(`doctor-${randomUUID()}`, age)),
+    );
+    const surplus = await Promise.all([4, 5].map((age) => sealed(`doctor-${randomUUID()}`, age)));
+    const withOutcome = await sealed(`doctor-${randomUUID()}`, 6);
+    await fs.writeFile(path.join(withOutcome, "outcome.json"), "{}");
+    const incomplete = path.join(store, `doctor-${randomUUID()}`);
+    await fs.mkdir(incomplete);
+    const update = await sealed(randomUUID(), 40);
+    const linkedId = `doctor-${randomUUID()}`;
+    const linkedTarget = await sealed(linkedId, 31, state.path("linked-capture"));
+    const linked = path.join(store, linkedId);
+    await fs.symlink(linkedTarget, linked, "dir");
+    const interrupted: string[] = [];
+    for (const kind of ["linked", "copied", "conflicting"]) {
+      const retained = await sealed(`doctor-${randomUUID()}`, 31);
+      const finalPath = path.join(retained, "manifest.json");
+      const partialPath = `${finalPath}.partial`;
+      if (kind === "linked") {
+        await fs.link(finalPath, partialPath);
+      } else if (kind === "copied") {
+        await fs.copyFile(finalPath, partialPath);
+      } else {
+        await fs.writeFile(partialPath, "different, unverified bytes");
+      }
+      interrupted.push(retained);
+    }
+    const assertCurrent = vi.fn();
+
+    const result = await retireStandaloneDoctorCaptures({
+      stateDir: state.stateDir,
+      keepRunId: path.basename(recent),
+      now,
+      assertCurrent,
+    });
+
+    expect(result.warnings).toEqual([]);
+    expect(result.retired.toSorted()).toEqual([expired, ...surplus].toSorted());
+    expect(assertCurrent).toHaveBeenCalled();
+    await expect(fs.lstat(expired)).rejects.toMatchObject({ code: "ENOENT" });
+    for (const retained of [
+      recent,
+      ...retainedRecent,
+      withOutcome,
+      incomplete,
+      update,
+      linkedTarget,
+      ...interrupted,
+    ]) {
+      expect((await fs.lstat(retained)).isDirectory()).toBe(true);
+    }
+    expect((await fs.lstat(linked)).isSymbolicLink()).toBe(true);
+    expect(await fs.readlink(linked)).toBe(linkedTarget);
+    // The age bound also applies when fewer than three eligible copies remain.
+    await fs.rm(retainedRecent[1]!, { recursive: true });
+    const expiredWithinCount = await sealed(`doctor-${randomUUID()}`, 40);
+    expect(
+      await retireStandaloneDoctorCaptures({
+        stateDir: state.stateDir,
+        keepRunId: path.basename(recent),
+        now,
+        assertCurrent,
+      }),
+    ).toEqual({ retired: [expiredWithinCount], warnings: [] });
+    expect(
+      await retireStandaloneDoctorCaptures({
+        stateDir: state.stateDir,
+        keepRunId: path.basename(recent),
+        now,
+        assertCurrent,
+      }),
+    ).toEqual({ retired: [], warnings: [] });
+    await expect(
+      retireStandaloneDoctorCaptures({
+        stateDir: state.stateDir,
+        keepRunId: path.basename(recent),
+        now,
+        assertCurrent: () => {
+          throw new Error("maintenance custody expired");
+        },
+      }),
+    ).rejects.toThrow("maintenance custody expired");
+    expect((await fs.lstat(recent)).isDirectory()).toBe(true);
+  });
+});
diff --git a/src/infra/update-recovery-doctor-retention.ts b/src/infra/update-recovery-doctor-retention.ts
new file mode 100644
index 0000000000..6a858f6af0
--- /dev/null
+++ b/src/infra/update-recovery-doctor-retention.ts
@@ -0,0 +1,132 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { parseUpdateRecoveryBackupManifest } from "../commands/backup-verify-manifest.js";
+import { hasErrnoCode } from "./errno.js";
+import { formatErrorMessage } from "./errors.js";
+import { root as safeRoot } from "./fs-safe.js";
+import { resolveUpdateCaptureRoot } from "./update-capture-paths.js";
+import { hasPendingUpdateRecoverySeal } from "./update-recovery-capture-seal.js";
+import { getUpdateRunAsync } from "./update-run-reader.js";
+
+const STANDALONE_DOCTOR_CAPTURE_RETENTION_MS = 30 * 24 * 60 * 60_000;
+const STANDALONE_DOCTOR_CAPTURE_COUNT = 3;
+
+/** Retain the newest three sealed standalone originals for at most 30 days under maintenance custody. */
+export async function retireStandaloneDoctorCaptures(params: {
+  stateDir: string;
+  keepRunId: string;
+  now?: number;
+  assertCurrent: () => void;
+}): Promise<{ retired: string[]; warnings: string[] }> {
+  const retired: string[] = [];
+  const warnings: string[] = [];
+  const root = resolveUpdateCaptureRoot(params.stateDir);
+  const now = params.now ?? Date.now();
+  const exists = async (filename: string) => {
+    try {
+      await fs.lstat(filename);
+      return true;
+    } catch (error) {
+      if (hasErrnoCode(error, "ENOENT")) {
+        return false;
+      }
+      throw error;
+    }
+  };
+  const inspect = async (name: string) => {
+    const directory = path.join(root, name);
+    const entry = await fs.lstat(directory);
+    if (
+      !entry.isDirectory() ||
+      entry.isSymbolicLink() ||
+      (await hasPendingUpdateRecoverySeal(directory)) ||
+      !(await exists(path.join(directory, "manifest.json")))
+    ) {
+      return undefined;
+    }
+    const source = await safeRoot(directory, { symlinks: "reject", hardlinks: "reject" });
+    const raw = await source.readText("manifest.json", { maxBytes: 128 * 1024 * 1024 });
+    const manifest = parseUpdateRecoveryBackupManifest(raw);
+    const createdAt = Date.parse(manifest.createdAt);
+    if (
+      manifest.runId !== name ||
+      manifest.schemaVersion !== 2 ||
+      manifest.generation?.kind !== "baseline" ||
+      !Number.isFinite(createdAt) ||
+      (await exists(path.join(directory, "outcome.json"))) ||
+      (await getUpdateRunAsync(name, {
+        path: path.join(params.stateDir, "state", "openclaw.sqlite"),
+      })) !== undefined
+    ) {
+      return undefined;
+    }
+    return { name, directory, createdAt, raw, dev: entry.dev, ino: entry.ino };
+  };
+  let names: string[];
+  params.assertCurrent();
+  try {
+    names = await fs.readdir(root);
+  } catch (error) {
+    if (!hasErrnoCode(error, "ENOENT")) {
+      warnings.push(
+        `Standalone Doctor capture retirement unavailable at ${root}: ${formatErrorMessage(error)}`,
+      );
+    }
+    return { retired, warnings };
+  }
+  const candidates: NonNullable<Awaited<ReturnType<typeof inspect>>>[] = [];
+  for (const name of names.toSorted()) {
+    if (
+      !/^doctor-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(name)
+    ) {
+      continue;
+    }
+    try {
+      const candidate = await inspect(name);
+      if (candidate) {
+        candidates.push(candidate);
+      }
+    } catch (error) {
+      warnings.push(
+        `Standalone Doctor capture retained at ${path.join(root, name)}: ${formatErrorMessage(error)}`,
+      );
+    }
+  }
+  candidates.sort(
+    (left, right) =>
+      Number(right.name === params.keepRunId) - Number(left.name === params.keepRunId) ||
+      right.createdAt - left.createdAt ||
+      left.name.localeCompare(right.name),
+  );
+  for (const [position, candidate] of candidates.entries()) {
+    if (
+      candidate.name === params.keepRunId ||
+      (position < STANDALONE_DOCTOR_CAPTURE_COUNT &&
+        now - candidate.createdAt <= STANDALONE_DOCTOR_CAPTURE_RETENTION_MS)
+    ) {
+      continue;
+    }
+    try {
+      const current = await inspect(candidate.name);
+      if (
+        !current ||
+        current.dev !== candidate.dev ||
+        current.ino !== candidate.ino ||
+        current.raw !== candidate.raw
+      ) {
+        throw new Error("Capture changed during retirement; recovery evidence was preserved.");
+      }
+      if (await hasPendingUpdateRecoverySeal(candidate.directory)) {
+        continue;
+      }
+      params.assertCurrent();
+      await fs.rm(candidate.directory, { recursive: true });
+      retired.push(candidate.directory);
+    } catch (error) {
+      warnings.push(
+        `Standalone Doctor capture retained at ${candidate.directory}: ${formatErrorMessage(error)}`,
+      );
+    }
+  }
+  return { retired, warnings };
+}
