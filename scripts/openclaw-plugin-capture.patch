+import fs from "node:fs";
+import { expect, it, vi } from "vitest";
+import { withOpenClawTestState } from "../test-utils/openclaw-test-state.js";
+import { writePersistedInstalledPluginIndex } from "./installed-plugin-index-store-write.js";
+import { readPersistedInstalledPluginIndex } from "./installed-plugin-index-store.js";
+import { createPluginCache, retirePluginCache, withPluginCache } from "./plugin-cache.js";
+import { createFixture } from "./plugin-generation-artifact.admission.test-support.js";
+import { capturePluginGenerationArtifact } from "./plugin-generation-artifact.js";
+import { withPluginLifecycleLease } from "./plugin-lifecycle-lease.js";
+import {
+  preparePluginNativeAdmissions,
+  settlePluginNativeAdmissions,
+} from "./plugin-native-admission-state.js";
+
+it("shares the live native event source across duplicated module graphs", async () => {
+  await withOpenClawTestState({ label: "native-event-module-graphs" }, async (state) => {
+    vi.resetModules();
+    const firstGraph = await import("./plugin-source-capture-native-loads.js");
+    const observed: string[] = [];
+    const release = firstGraph.subscribePluginNativeLoads((filename) => observed.push(filename));
+    try {
+      vi.resetModules();
+      const secondGraph = await import("./plugin-source-capture-native-loads.js");
+      const filename = state.path("shared-native.node");
+      secondGraph.recordPluginNativeLoad(filename);
+      expect(observed).toEqual([filename]);
+      release();
+      secondGraph.recordPluginNativeLoad(state.path("released-native.node"));
+      expect(observed).toEqual([filename]);
+    } finally {
+      release();
+    }
+  });
+});
+
+it("shares persisted native admission across duplicated module graphs", async () => {
+  await withOpenClawTestState({ label: "native-module-graph-lineage" }, async (state) => {
+    const fixture = createFixture(state.path("installed"), true);
+    await writePersistedInstalledPluginIndex(fixture.index, { stateDir: state.stateDir });
+    const seedCache = createPluginCache();
+    preparePluginNativeAdmissions(fixture.index, seedCache);
+    const seedArtifact = withPluginCache(seedCache, () =>
+      capturePluginGenerationArtifact(fixture.root),
+    );
+    try {
+      await withPluginLifecycleLease({ env: state.env }, () =>
+        settlePluginNativeAdmissions(seedCache),
+      );
+      const persisted = await readPersistedInstalledPluginIndex({ stateDir: state.stateDir });
+      if (!persisted) {
+        throw new Error("Native admission did not persist its installed index");
+      }
+      const receipt = Object.values(persisted.plugins[0]?.sourceAdmissions ?? {})[0];
+      const capturedPath = receipt?.nativeArtifacts[fixture.filename]?.capturedPath;
+      expect(capturedPath).toBeDefined();
+
+      vi.resetModules();
+      const firstGraph = await import("./plugin-native-admission-state.js");
+      vi.resetModules();
+      const secondGraph = await import("./plugin-generation-artifact.js");
+      const cache = createPluginCache();
+      firstGraph.preparePluginNativeAdmissions(persisted, cache);
+      const secondArtifact = withPluginCache(cache, () =>
+        secondGraph.capturePluginGenerationArtifact(fixture.root),
+      );
+      try {
+        expect(fs.realpathSync(secondArtifact.resolve(fixture.filename))).toBe(
+          fs.realpathSync(capturedPath!),
+        );
+      } finally {
+        await secondArtifact.disposeAsync();
+        await retirePluginCache(cache);
+      }
+    } finally {
+      await seedArtifact.disposeAsync();
+      await retirePluginCache(seedCache);
+    }
+  });
+});
