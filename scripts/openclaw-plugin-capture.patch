+  const entered = createDeferredCore();
+  const release = createDeferredCore();
+  const prepare = preparation.preparePluginGenerationArtifact;
+  const createRoot = captureDirectories.createPluginSourceCaptureRoot;
+  const roots: string[] = [];
+  let started = 0;
+  vi.spyOn(captureDirectories, "createPluginSourceCaptureRoot").mockImplementation((...args) => {
+    const root = createRoot(...args);
+    roots.push(root.directory);
+    return root;
+  });
+  vi.spyOn(preparation, "preparePluginGenerationArtifact").mockImplementation(
+    async (parameters) => {
+      if (++started === Math.min(2, availableParallelism())) {
+        entered.resolve();
+      }
+      await release.promise;
+      return prepare(parameters);
+    },
+  );
+  const loading = withPluginSourceCaptureStorage(
+    { stateDir: makePluginLoaderTempDir(), placement: "temporary" },
+    () => withPluginCache(cache, () => loadOpenClawPluginsAsync(options)),
+  );
+  const outcome = loading.then(
+    (registry) => ({ registry }),
+    (error: unknown) => ({ error }),
+  );
+  try {
+    await Promise.race([
+      entered.promise,
+      outcome.then(() => {
+        throw new Error("Inventory completed before the capture gate");
+      }),
+    ]);
+    const retirement = retirePluginCache(cache);
+    release.resolve();
+    expect(await outcome).toMatchObject({
+      error: { message: expect.stringContaining("inventory has retired") },
+    });
+    await retirement;
+    expect(roots).toHaveLength(Math.min(2, availableParallelism()));
+    expect(roots.every((directory) => !fs.existsSync(directory))).toBe(true);
+    expect(cache.instances.size).toBe(0);
+  } finally {
+    release.resolve();
+    await outcome;
+    await retirePluginCache(cache);
+  }
+});
