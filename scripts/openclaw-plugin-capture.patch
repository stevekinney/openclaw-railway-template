+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import { withOpenClawTestState } from "../test-utils/openclaw-test-state.js";
+import { capturePluginGenerationArtifact } from "./plugin-generation-artifact.js";
+import { createPluginGenerationReceipt } from "./plugin-generation-receipt.js";
+import { withPluginSourceCaptureDirectory } from "./plugin-package-metadata-capture.js";
+import { withPluginSourceCaptureStorage } from "./plugin-source-capture-context.js";
+import {
+  createPluginNativeCaptureRoot,
+  createPluginSourceCaptureRoot,
+} from "./plugin-source-capture-directory.js";
+import { hashPluginSourceFile } from "./plugin-source-file.js";
+
+const temporaryDirectories = useAutoCleanupTempDirTracker(afterEach);
+const artifacts: ReturnType<typeof capturePluginGenerationArtifact>[] = [];
+afterEach(() => {
+  vi.restoreAllMocks();
+  for (const artifact of artifacts.splice(0)) {
+    artifact.dispose();
+  }
+});
+
+it("inspects copied bytes once for content and the unchanged receipt before admission", () => {
+  const root = fs.realpathSync(temporaryDirectories.make("plugin-receipt-hashing-"));
+  const sourceDirectory = path.join(root, "source");
+  const captureDirectory = path.join(root, "captures");
+  fs.mkdirSync(sourceDirectory);
+  fs.mkdirSync(captureDirectory);
+  const source = path.join(sourceDirectory, "payload.dat");
+  const bytes = Buffer.alloc(2 * 1024 * 1024 + 3, "receipt bytes");
+  fs.writeFileSync(source, bytes);
+  const original = fs.statSync(source, { bigint: true });
+  const readSync = fs.readSync;
+  let copiedBytesInspected = 0;
+  const reads = vi.spyOn(fs, "readSync").mockImplementation((...arguments_) => {
+    const length = Reflect.apply(readSync, fs, arguments_);
+    const current = fs.fstatSync(arguments_[0], { bigint: true });
+    if (
+      current.size === BigInt(bytes.length) &&
+      (current.dev !== original.dev || current.ino !== original.ino)
+    ) {
+      copiedBytesInspected += length;
+    }
+    return length;
+  });
+  const artifact = withPluginSourceCaptureDirectory(captureDirectory, () =>
+    capturePluginGenerationArtifact(sourceDirectory),
+  );
+  artifacts.push(artifact);
+  reads.mockRestore();
+
+  expect(copiedBytesInspected).toBe(bytes.length);
+  const expectedReceipt = createHash("sha256")
+    .update("package-0\0directory\0\0file\0payload.dat\0")
+    .update(String(bytes.length))
+    .update("\0")
+    .update(bytes)
+    .digest("hex");
+  expect(artifact.sourceDigest).toBe(expectedReceipt);
+  expect(fs.readFileSync(artifact.resolve(source))).toEqual(bytes);
+  expect(() => artifact.assertSourceCurrent()).not.toThrow();
+  fs.writeFileSync(source, "changed original");
+  expect(() => artifact.assertSourceCurrent()).toThrow("Plugin source changed");
+  expect(fs.readFileSync(artifact.resolve(source))).toEqual(bytes);
+});
+
+it("validates prepared ordinary targets before reusing a receipt", () => {
+  const root = fs.realpathSync(temporaryDirectories.make("plugin-receipt-prepared-"));
+  const target = path.join(root, "captured.js");
+  fs.writeFileSync(target, "original");
+  const content = hashPluginSourceFile(target, root);
+  const first = createPluginGenerationReceipt();
+  first.marker("file\0captured.js\0");
+  first.file({
+    target,
+    boundary: root,
+    sizeBytes: content.sizeBytes,
+    native: false,
+    onContent: () => {},
+  });
+  const prepared = first.finish();
+  fs.writeFileSync(target, "changed!");
+  const second = createPluginGenerationReceipt(prepared);
+  second.marker("file\0captured.js\0");
+  second.file({
+    target,
+    boundary: root,
+    sizeBytes: content.sizeBytes,
+    native: false,
+    prepared: content,
+    onContent: () => {},
+  });
+  expect(() => second.finish()).toThrow(
+    "Plugin source changed while preparing its reload; retry after the edit finishes.",
+  );
+});
+
+it("keeps execution copies in temporary storage while native captures retain state placement", async () => {
+  await withOpenClawTestState({ label: "plugin-execution-copy-placement" }, async (state) => {
+    const temporary = fs.realpathSync(temporaryDirectories.make("plugin-execution-temp-"));
+    for (const name of ["TMPDIR", "TMP", "TEMP"]) {
+      vi.stubEnv(name, temporary);
+    }
+    const source = state.path("plugin");
+    fs.mkdirSync(source);
+    fs.writeFileSync(path.join(source, "index.cjs"), "module.exports = 42;");
+    const native = createPluginNativeCaptureRoot();
+    const worker = createPluginSourceCaptureRoot(state.stateDir, "openclaw-model-catalog-");
+    try {
+      const ordinary = capturePluginGenerationArtifact(source);
+      artifacts.push(ordinary);
+      expect(path.relative(tmpdir(), ordinary.boundaryRoot).startsWith("..")).toBe(false);
+      expect(path.relative(tmpdir(), worker.directory).startsWith("..")).toBe(false);
+      expect(
+        path
+          .relative(path.join(state.stateDir, "tmp", "plugin-captures"), native.directory)
+          .startsWith(".."),
+      ).toBe(false);
+      const explicit = withPluginSourceCaptureStorage(
+        { stateDir: state.stateDir, placement: "state" },
+        () => capturePluginGenerationArtifact(source),
+      );
+      artifacts.push(explicit);
+      expect(
+        path
+          .relative(path.join(state.stateDir, "tmp", "plugin-captures"), explicit.boundaryRoot)
+          .startsWith(".."),
+      ).toBe(false);
+    } finally {
+      await worker.release();
+      await native.disposeAsync();
+      vi.unstubAllEnvs();
+    }
+  });
+});
+
+it("does not capture its own temporary tree when the source contains temporary storage", () => {
+  const source = fs.realpathSync(temporaryDirectories.make("plugin-containing-temp-"));
+  const temporary = path.join(source, "runtime-temporary");
+  fs.mkdirSync(temporary);
+  fs.writeFileSync(path.join(source, "index.cjs"), "module.exports = 42;");
+  for (const name of ["TMPDIR", "TMP", "TEMP"]) {
+    vi.stubEnv(name, temporary);
+  }
+  try {
+    const artifact = capturePluginGenerationArtifact(source);
+    artifacts.push(artifact);
+    expect(fs.readFileSync(artifact.resolve(path.join(source, "index.cjs")), "utf8")).toBe(
+      "module.exports = 42;",
+    );
+    expect(() => artifact.assertSourceCurrent()).not.toThrow();
+  } finally {
+    vi.unstubAllEnvs();
+  }
+});
