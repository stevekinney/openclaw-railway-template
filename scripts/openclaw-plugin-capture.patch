diff --git a/packages/worker-runtime/src/worker-task-server.test.ts b/packages/worker-runtime/src/worker-task-server.test.ts
new file mode 100644
index 0000000000..0b30bc4bd1
--- /dev/null
+++ b/packages/worker-runtime/src/worker-task-server.test.ts
@@ -0,0 +1,120 @@
+import { EventEmitter } from "node:events";
+import { setImmediate as nextTurn } from "node:timers/promises";
+import { afterEach, expect, it, vi } from "vitest";
+
+const parentPort = new EventEmitter() as EventEmitter & {
+  postMessage: ReturnType<typeof vi.fn>;
+};
+parentPort.postMessage = vi.fn();
+
+vi.mock("node:worker_threads", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("node:worker_threads")>()),
+  parentPort,
+}));
+
+const { serveOwnedWorkerTasks } = await import("./worker-task-server.js");
+
+function host() {
+  return {
+    initialize: vi.fn(),
+    onMessage: vi.fn(),
+    installTaskContext: vi.fn(),
+    onIdle: vi.fn(),
+  };
+}
+
+function task(taskId: number, input: unknown) {
+  return {
+    input,
+    taskId,
+    nativeSections: new SharedArrayBuffer(4),
+    taskContext: undefined,
+  };
+}
+
+async function settle() {
+  await nextTurn();
+  await nextTurn();
+}
+
+afterEach(() => {
+  parentPort.removeAllListeners();
+  parentPort.postMessage.mockClear();
+  vi.restoreAllMocks();
+});
+
+it("notifies after successful and failed replies without duplicating response frames", async () => {
+  const replies = vi.fn();
+  const idle = vi.fn();
+  const onReplySent = vi.fn(replies);
+  serveOwnedWorkerTasks(
+    async (input) => {
+      if (input === "failure") {
+        throw new Error("synthetic failure");
+      }
+      return input;
+    },
+    { onReplySent },
+    { ...host(), onIdle: idle },
+  );
+
+  parentPort.emit("message", task(1, "success"));
+  await settle();
+  parentPort.emit("message", task(2, "failure"));
+  await settle();
+
+  expect(parentPort.postMessage).toHaveBeenCalledTimes(2);
+  expect(parentPort.postMessage.mock.calls.map(([message]) => message.status)).toEqual([
+    "ok",
+    "failed",
+  ]);
+  expect(onReplySent).toHaveBeenCalledTimes(2);
+  expect(replies).toHaveBeenCalledTimes(2);
+  expect(idle).toHaveBeenCalledTimes(2);
+  for (let index = 0; index < 2; index += 1) {
+    expect(onReplySent.mock.invocationCallOrder[index]).toBeGreaterThan(
+      parentPort.postMessage.mock.invocationCallOrder[index]!,
+    );
+    expect(idle.mock.invocationCallOrder[index]).toBeGreaterThan(
+      onReplySent.mock.invocationCallOrder[index]!,
+    );
+  }
+});
+
+it.each([false, true])("notifies and closes resource receipts after failure=%s", async (fails) => {
+  const idle = vi.fn();
+  const onReplySent = vi.fn();
+  const closeResource = vi.fn(async () => {
+    if (fails) {
+      throw new Error("resource cleanup failed");
+    }
+  });
+  const receipt = { postMessage: vi.fn(), close: vi.fn() };
+  serveOwnedWorkerTasks(
+    async (input) => input,
+    { closeResource, onReplySent },
+    { ...host(), onIdle: idle },
+  );
+
+  parentPort.emit("message", {
+    closeResource: true,
+    key: "resource-key",
+    resourcePort: receipt,
+  });
+  await settle();
+
+  expect(closeResource).toHaveBeenCalledWith("resource-key");
+  expect(receipt.postMessage).toHaveBeenCalledOnce();
+  expect(receipt.postMessage.mock.calls[0]?.[0]).toMatchObject(
+    fails ? { ok: false, error: "resource cleanup failed" } : { ok: true },
+  );
+  expect(receipt.close).toHaveBeenCalledOnce();
+  expect(onReplySent).toHaveBeenCalledOnce();
+  expect(idle).toHaveBeenCalledOnce();
+  expect(onReplySent.mock.invocationCallOrder[0]).toBeGreaterThan(
+    receipt.postMessage.mock.invocationCallOrder[0]!,
+  );
+  expect(onReplySent.mock.invocationCallOrder[0]).toBeGreaterThan(
+    receipt.close.mock.invocationCallOrder[0]!,
+  );
+});
