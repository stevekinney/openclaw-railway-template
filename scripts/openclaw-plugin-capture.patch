diff --git a/src/plugins/plugin-instance-bundled-loader.ts b/src/plugins/plugin-instance-bundled-loader.ts
new file mode 100644
index 0000000000..cb4cd44fe3
--- /dev/null
+++ b/src/plugins/plugin-instance-bundled-loader.ts
@@ -0,0 +1,35 @@
+import type { PluginModuleLoader } from "./plugin-cache-artifacts.js";
+import type { PluginCache } from "./plugin-cache.types.js";
+import { getCachedPluginModuleLoader } from "./plugin-module-loader-cache.js";
+import type { PluginInstanceModuleLoaderParams } from "./plugin-module-loader-recovery.js";
+import { installOpenClawPluginSdkNativeResolver } from "./plugin-sdk-native-resolver.js";
+import { bindSharedPluginModuleLoader } from "./plugin-shared-module-loader.js";
+
+export function bindBundledPluginInstanceModuleLoader(
+  params: PluginInstanceModuleLoaderParams,
+  cache: PluginCache,
+): void {
+  let loader: PluginModuleLoader;
+  if (params.createHostModuleLoader) {
+    loader = params.createHostModuleLoader();
+  } else {
+    installOpenClawPluginSdkNativeResolver({
+      moduleUrl: import.meta.url,
+      pluginModulePath: params.source,
+      devSourceRoot: params.devSourceRoot,
+      pluginSdkResolution: params.pluginSdkResolution,
+    });
+    loader = getCachedPluginModuleLoader({
+      modulePath: params.source,
+      importerUrl: import.meta.url,
+      devSourceRoot: params.devSourceRoot,
+      pluginSdkResolution: params.pluginSdkResolution,
+    });
+  }
+  bindSharedPluginModuleLoader({
+    instance: params.instance,
+    rootDir: params.rootDir,
+    cache,
+    loader,
+  });
+}
