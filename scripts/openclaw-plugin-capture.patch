+  stateDir: string;
+  keepRunId: string;
+  now?: number;
+  assertCurrent: () => void;
+}): Promise<{ retired: string[]; warnings: string[] }> {
+  const retired: string[] = [];
+  const warnings: string[] = [];
+  const root = resolveUpdateCaptureRoot(params.stateDir);
+  const now = params.now ?? Date.now();
+  const exists = async (filename: string) => {
+    try {
+      await fs.lstat(filename);
+      return true;
+    } catch (error) {
+      if (hasErrnoCode(error, "ENOENT")) {
+        return false;
+      }
+      throw error;
+    }
+  };
+  const inspect = async (name: string) => {
+    const directory = path.join(root, name);
+    const entry = await fs.lstat(directory);
+    if (
+      !entry.isDirectory() ||
+      entry.isSymbolicLink() ||
+      (await hasPendingUpdateRecoverySeal(directory)) ||
+      !(await exists(path.join(directory, "manifest.json")))
+    ) {
+      return undefined;
+    }
+    const source = await safeRoot(directory, { symlinks: "reject", hardlinks: "reject" });
+    const raw = await source.readText("manifest.json", { maxBytes: 128 * 1024 * 1024 });
+    const manifest = parseUpdateRecoveryBackupManifest(raw);
+    const createdAt = Date.parse(manifest.createdAt);
+    if (
+      manifest.runId !== name ||
+      manifest.schemaVersion !== 2 ||
+      manifest.generation?.kind !== "baseline" ||
+      !Number.isFinite(createdAt) ||
+      (await exists(path.join(directory, "outcome.json"))) ||
+      (await getUpdateRunAsync(name, {
+        path: path.join(params.stateDir, "state", "openclaw.sqlite"),
+      })) !== undefined
+    ) {
+      return undefined;
+    }
+    return { name, directory, createdAt, raw, dev: entry.dev, ino: entry.ino };
+  };
+  let names: string[];
+  params.assertCurrent();
+  try {
+    names = await fs.readdir(root);
+  } catch (error) {
+    if (!hasErrnoCode(error, "ENOENT")) {
+      warnings.push(
+        `Standalone Doctor capture retirement unavailable at ${root}: ${formatErrorMessage(error)}`,
+      );
+    }
+    return { retired, warnings };
+  }
+  const candidates: NonNullable<Awaited<ReturnType<typeof inspect>>>[] = [];
+  for (const name of names.toSorted()) {
+    if (
+      !/^doctor-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u.test(name)
+    ) {
+      continue;
+    }
+    try {
+      const candidate = await inspect(name);
+      if (candidate) {
+        candidates.push(candidate);
+      }
+    } catch (error) {
+      warnings.push(
+        `Standalone Doctor capture retained at ${path.join(root, name)}: ${formatErrorMessage(error)}`,
+      );
+    }
+  }
+  candidates.sort(
+    (left, right) =>
+      Number(right.name === params.keepRunId) - Number(left.name === params.keepRunId) ||
+      right.createdAt - left.createdAt ||
+      left.name.localeCompare(right.name),
+  );
+  for (const [position, candidate] of candidates.entries()) {
+    if (
+      candidate.name === params.keepRunId ||
+      (position < STANDALONE_DOCTOR_CAPTURE_COUNT &&
+        now - candidate.createdAt <= STANDALONE_DOCTOR_CAPTURE_RETENTION_MS)
+    ) {
+      continue;
+    }
+    try {
+      const current = await inspect(candidate.name);
+      if (
+        !current ||
+        current.dev !== candidate.dev ||
+        current.ino !== candidate.ino ||
+        current.raw !== candidate.raw
+      ) {
+        throw new Error("Capture changed during retirement; recovery evidence was preserved.");
+      }
+      if (await hasPendingUpdateRecoverySeal(candidate.directory)) {
+        continue;
+      }
+      params.assertCurrent();
+      await fs.rm(candidate.directory, { recursive: true });
+      retired.push(candidate.directory);
+    } catch (error) {
+      warnings.push(
+        `Standalone Doctor capture retained at ${candidate.directory}: ${formatErrorMessage(error)}`,
+      );
+    }
+  }
+  return { retired, warnings };
+}
