+import fs from "node:fs";
+import path from "node:path";
+import { afterEach, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import { createFixture } from "./plugin-generation-artifact.admission.test-support.js";
+import { preparePluginGenerationArtifact } from "./plugin-generation-worker.js";
+import { withPluginSourceCaptureStorage } from "./plugin-source-capture-context.js";
+
+const temporaryDirectories = useAutoCleanupTempDirTracker(afterEach);
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+
+it("wakes synchronous joins for mapping and ordinary replies instead of timing out each poll", async () => {
+  const root = fs.realpathSync(temporaryDirectories.make("plugin-worker-notification-"));
+  const fixture = createFixture(path.join(root, "installed"), false);
+  const waits: string[] = [];
+  const expectedCounters: number[] = [];
+  let collecting = false;
+  let raced = false;
+  const wait = Atomics.wait;
+  vi.spyOn(Atomics, "wait").mockImplementation((...arguments_) => {
+    const [activity, index, expected, timeout] = arguments_;
+    if (collecting && timeout === 2) {
+      expectedCounters.push(Number(expected));
+      // Deliver activity in the actual join after its pending read and before its wait.
+      if (!raced && activity instanceof Int32Array) {
+        Atomics.add(activity, index, 1);
+        raced = true;
+        const outcome = Reflect.apply(wait, Atomics, arguments_);
+        expect(outcome).toBe("not-equal");
+        waits.push(outcome);
+        return outcome;
+      }
+    }
+    const outcome = Reflect.apply(wait, Atomics, arguments_);
+    if (collecting && timeout === 2) {
+      waits.push(outcome);
+    }
+    return outcome;
+  });
+
+  await withPluginSourceCaptureStorage({ stateDir: root, placement: "temporary" }, async () => {
+    const prepared = await preparePluginGenerationArtifact({
+      rootDir: fixture.root,
+      source: fixture.entry,
+    });
+    try {
+      collecting = true;
+      for (let index = 0; index < 24; index += 1) {
+        prepared.artifact.prepareModule(prepared.artifact.resolve(fixture.entry));
+        prepared.artifact.prepareNativeScopes();
+      }
+    } finally {
+      collecting = false;
+      await prepared.artifact.disposeAsync();
+    }
+  });
+
+  expect(raced).toBe(true);
+  expect(expectedCounters.length).toBeGreaterThan(0);
+  // The host may receive the initial reply before its sender increments the counter.
+  expect(expectedCounters.some((counter) => counter > 0)).toBe(true);
+  expect(expectedCounters.at(-1)).toBeGreaterThan(expectedCounters[0]! + 1);
+  expect(waits.some((outcome) => outcome === "ok" || outcome === "not-equal")).toBe(true);
+  expect(waits.filter((outcome) => outcome === "timed-out").length).toBeLessThan(waits.length);
+});
+
+it("keeps worker rejection and cleanup observable through the notification path", async () => {
+  const root = fs.realpathSync(temporaryDirectories.make("plugin-worker-notification-failure-"));
+  const fixture = createFixture(path.join(root, "installed"), false);
+
+  await withPluginSourceCaptureStorage({ stateDir: root, placement: "temporary" }, async () => {
+    await expect(
+      preparePluginGenerationArtifact({
+        rootDir: path.join(fixture.root, "missing"),
+        source: fixture.entry,
+      }),
+    ).rejects.toThrow();
+  });
+});
