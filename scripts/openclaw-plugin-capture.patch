+
+it("validates prepared ordinary targets before reusing a receipt", () => {
+  const root = fs.realpathSync(temporaryDirectories.make("plugin-receipt-prepared-"));
+  const target = path.join(root, "captured.js");
+  fs.writeFileSync(target, "original");
+  const content = hashPluginSourceFile(target, root);
+  const first = createPluginGenerationReceipt();
+  first.marker("file\0captured.js\0");
+  first.file({
+    target,
+    boundary: root,
+    sizeBytes: content.sizeBytes,
+    native: false,
+    onContent: () => {},
+  });
+  const prepared = first.finish();
+  fs.writeFileSync(target, "changed!");
+  const second = createPluginGenerationReceipt(prepared);
+  second.marker("file\0captured.js\0");
+  second.file({
+    target,
+    boundary: root,
+    sizeBytes: content.sizeBytes,
+    native: false,
+    prepared: content,
+    onContent: () => {},
+  });
+  expect(() => second.finish()).toThrow(
+    "Plugin source changed while preparing its reload; retry after the edit finishes.",
+  );
+});
+
+it("keeps execution copies in temporary storage while native captures retain state placement", async () => {
+  await withOpenClawTestState({ label: "plugin-execution-copy-placement" }, async (state) => {
+    const temporary = fs.realpathSync(temporaryDirectories.make("plugin-execution-temp-"));
+    for (const name of ["TMPDIR", "TMP", "TEMP"]) {
+      vi.stubEnv(name, temporary);
+    }
+    const source = state.path("plugin");
+    fs.mkdirSync(source);
+    fs.writeFileSync(path.join(source, "index.cjs"), "module.exports = 42;");
+    const native = createPluginNativeCaptureRoot();
+    const worker = createPluginSourceCaptureRoot(state.stateDir, "openclaw-model-catalog-");
+    try {
+      const ordinary = capturePluginGenerationArtifact(source);
+      artifacts.push(ordinary);
+      expect(path.relative(tmpdir(), ordinary.boundaryRoot).startsWith("..")).toBe(false);
+      expect(path.relative(tmpdir(), worker.directory).startsWith("..")).toBe(false);
+      expect(
+        path
+          .relative(path.join(state.stateDir, "tmp", "plugin-captures"), native.directory)
+          .startsWith(".."),
+      ).toBe(false);
+      const explicit = withPluginSourceCaptureStorage(
+        { stateDir: state.stateDir, placement: "state" },
