{
  "agents": {
    "defaults": {
      "heartbeat": {
        "directPolicy": "allow"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      },
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "tailscale": {
      "mode": "serve"
    },
    "terminal": {
      "enabled": false
    },
    "nodes": {
      "pairing": {
        "sshVerify": false
      }
    }
  }
}
