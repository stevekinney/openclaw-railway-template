# Runtime variables for the Railway service. Full reference, including
# build-time settings and what lives on the volume: documentation/CONFIGURATION.md.
#
# Nothing in this repository reads this file. On Railway, set each value as a
# service variable and seal the secrets. Locally, copy it to .env and pass it
# with `docker run --env-file .env ...`.

# ── openclaw service ──────────────────────────────────────────────────────────

# No PORT variable: Railway injects PORT=8080, where the health relay listens.
# The Gateway itself listens on 127.0.0.1:18789 and is reached through
# Tailscale Serve.

# Required secret. Gateway authentication token, at least 32 characters, for
# clients that don't sign in with their tailnet identity (Mac app, CLI, API).
# Generate with: openssl rand -hex 32 (the Railway template generates it).
OPENCLAW_GATEWAY_TOKEN=

# Required secret on first boot. Tailscale auth key: admin console, Settings,
# Keys. Used once to log the container in to your tailnet; afterwards the node
# key on the volume logs in. Single-use, non-ephemeral, tagged if your policy
# defines tag:openclaw.
TS_AUTHKEY=

# Name for this Gateway, shown in OpenClaw's apps. At first login it also names
# the Tailscale machine, made into a DNS label: "My Gateway" ->
# https://my-gateway.<tailnet>.ts.net. Without it, both are openclaw.
OPENCLAW_MACHINE_DISPLAY_NAME=

# Optional. Overrides the machine name derived from OPENCLAW_MACHINE_DISPLAY_NAME.
# TS_HOSTNAME=openclaw

# Secret. Key for the model provider you onboard with (documentation/DEPLOYMENT.md step 4).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Secret, optional. Telegram bot token from @BotFather; enables the Telegram channel.
TELEGRAM_BOT_TOKEN=

# Secret, optional. Password for gog's token file (documentation/TOOLS.md).
# GOG_KEYRING_PASSWORD=
