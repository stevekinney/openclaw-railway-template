# Runtime variables for the Railway service. Full reference, including
# build-time settings and what lives on the volume: documentation/CONFIGURATION.md.
#
# Nothing in this repository reads this file. On Railway, set each value as a
# service variable and seal the secrets. Locally, copy it to .env and pass it
# with `docker run --env-file .env ...`.

# ── openclaw service ──────────────────────────────────────────────────────────

# No PORT variable: Railway injects PORT=8080, where the health relay listens.
# The Gateway itself listens on 127.0.0.1:18789 and is reached through
# Tailscale Serve.

# Required secret. Gateway authentication token, at least 32 characters, for
# clients that don't sign in with their tailnet identity (Mac app, CLI, API).
# Generate with: openssl rand -hex 32 (the Railway template generates it).
OPENCLAW_GATEWAY_TOKEN=

# Required secret on first boot. Tailscale auth key: admin console, Settings,
# Keys. Used once to log the container in to your tailnet; afterwards the node
# key on the volume logs in.
#
# Auth key settings: not reusable, not ephemeral, pre-approved if your tailnet
# requires device approval, and tagged `tag:openclaw` if your policy defines it.
# Expiry, the machine's key expiry, and why: https://github.com/stevekinney/openclaw-railway-template/blob/main/documentation/TAILSCALE.md#auth-key-settings
TS_AUTHKEY=

# The display name: this Gateway's name, shown in OpenClaw's machine picker. At
# first login it also names the Tailscale machine (the machine name), made into
# a DNS label: "My Gateway" -> https://my-gateway.<tailnet>.ts.net. Without it,
# both are openclaw.
OPENCLAW_MACHINE_DISPLAY_NAME=

# Optional. The machine name (Tailscale DNS label); overrides the one derived
# from OPENCLAW_MACHINE_DISPLAY_NAME.
# TS_HOSTNAME=openclaw

# Secret. Key for the model provider you onboard with (documentation/DEPLOYMENT.md step 4).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Secret, optional. Telegram bot token from @BotFather; enables the Telegram channel.
TELEGRAM_BOT_TOKEN=

# Secret, optional. Password for gog's token file (documentation/TOOLS.md).
# GOG_KEYRING_PASSWORD=

# Optional. "on" serves the webhook routes (POST /hooks/<name>, POST
# /gmail-pubsub) on PORT. Public only if the service has a Railway domain
# (documentation/WEBHOOKS.md).
# OPENCLAW_RAILWAY_WEBHOOKS=on

# Secret, needed for webhooks. Token that callers of /hooks/<name> must send;
# use one dedicated to hooks.
# OPENCLAW_HOOKS_TOKEN=

# Secret, needed for Gmail push. Token in the Pub/Sub push URL.
# OPENCLAW_GMAIL_PUSH_TOKEN=
